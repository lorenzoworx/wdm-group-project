# public_html/api/.htaccess
# Do NOT add AddHandler/AddType here; PHP-FPM handles .php globally on cPanel.

# Inside /api we serve real PHP files, so turn off SPA rewrites
<IfModule mod_rewrite.c>
  RewriteEngine Off
</IfModule>

# Preserve Authorization header (Bearer tokens etc.)
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# No directory listing
Options -Indexes
