# public_html/api/.htaccess

# Do NOT add AddHandler/AddType here; PHP-FPM handles .php globally on cPanel.

# Make sure React's SPA rewriting is OFF inside /api (we serve real files here)
<IfModule mod_rewrite.c>
  RewriteEngine Off
</IfModule>

# Preserve Authorization header for PHP (Bearer tokens/etc.)
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# No directory listing
Options -Indexes
