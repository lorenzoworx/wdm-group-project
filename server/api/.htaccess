# --- Make Authorization available to PHP (safe to keep globally) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# --- CORS for /api/* only (covers preflight + normal responses) ---
<IfModule mod_headers.c>
  # Mark API requests
  SetEnvIfNoCase Request_URI "^/api/" IS_API=1

  # If you don't use cookies, wildcard is fine with Authorization headers
  Header always set Access-Control-Allow-Origin "*" env=IS_API
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization" env=IS_API
  Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" env=IS_API
  Header merge Vary "Origin" env=IS_API
</IfModule>

# --- Answer OPTIONS preflight for /api/* at Apache layer ---
<IfModule mod_rewrite.c>
  # (RewriteEngine is already On above)
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteCond %{REQUEST_METHOD} =OPTIONS
  RewriteRule ^ - [R=204,L]
</IfModule>
