# Prevent SPA rewrite for API endpoints and protect .env
<IfModule mod_rewrite.c>
  RewriteEngine On

  # If the request is for the API folder, do not rewrite
  RewriteRule ^api/ - [L]

  # Serve existing files/directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise rewrite to index.html (SPA)
  RewriteRule ^ index.html [L]
</IfModule>

# Deny access to .env files for security
<FilesMatch "^\.env$">
  Require all denied
</FilesMatch>
