# public_html/.htaccess
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite /api/* — let Apache/PHP handle real PHP files
  RewriteRule ^api/ - [L]

  # Serve existing files or folders directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise send everything to React's index.html
  RewriteRule . /index.html [L]
</IfModule>
