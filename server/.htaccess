# public_html/.htaccess   (this lives at the web root)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1) never rewrite API requests (let PHP files run)
  RewriteRule ^api/ - [L]

  # 2) serve existing files/folders
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3) fallback to the SPA
  RewriteRule . /index.html [L]
</IfModule>

# Do not serve .env files
<FilesMatch "^\.env$">
  Require all denied
</FilesMatch>
